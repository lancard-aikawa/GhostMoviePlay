{
  "version": 1,
  "meta": {
    "title": "パスワード付き zip はファイル名を隠さない",
    "lang": "ja",
    "project": "GhostMoviePlay"
  },
  "app": {
    "window": "gmp\\sample",
    "start": "call \"%ProgramFiles%\\7-Zip\\7zFM.exe\" \"%SystemDrive%\\gmp\\sample\"",
    "cwd": ".",
    "start_timeout": 60.0,
    "setup": "python make_sample.py",
    "teardown": "python make_sample.py --clean"
  },
  "video": {
    "width": 1440,
    "height": 752,
    "fps": 30,
    "leader": 2.5,
    "trailer": 1.2
  },
  "voice": {
    "engine": "voicevox",
    "speaker": "ずんだもん",
    "style": "ノーマル",
    "speed": 1.05,
    "pitch": 0.0,
    "intonation": 1.0,
    "volume": 1.0,
    "pre": 0.1,
    "post": 0.1,
    "credit": "VOICEVOX:ずんだもん",
    "dict": {
      "段": "ダン",
      "尺": "シャク",
      "層": "ソウ",
      "mp4": "エムピーフォー",
      "JSON": "ジェイソン",
      "URL": "ユーアールエル",
      "zip": "ジップ",
      "7z": "セブンゼット",
      "7-Zip": "セブンジップ",
      "AES": "エーイーエス"
    }
  },
  "scenes": [
    {
      "id": "leak",
      "title": "パスワードを付けたのに",
      "beats": [
        {
          "say": "社外に渡すファイルを、パスワードを付けて守ることにします。",
          "subtitle": "社外に渡すファイルを、パスワードを付けて守る",
          "audio": "voice/000_leak.wav",
          "actions": [
            {
              "type": "wait_for",
              "selector": "row*=給与明細",
              "seconds": 20
            }
          ]
        },
        {
          "say": "四つとも選んで、書庫に追加します。",
          "audio": "voice/001_leak.wav",
          "actions": [
            {
              "type": "press",
              "key": "Control+a"
            }
          ]
        },
        {
          "say": "形式は zip。パスワードを入れて、暗号化方式は AES 256 にします。用意されている中でいちばん強いものです。",
          "subtitle": "形式は zip、暗号化方式は AES-256。いちばん強いものを選ぶ",
          "audio": "voice/002_leak.wav",
          "actions": [
            {
              "type": "click",
              "selector": "at=0.017,0.09"
            },
            {
              "type": "wait_for",
              "selector": "win=圧縮",
              "seconds": 20
            },
            {
              "type": "select",
              "selector": "cid=104",
              "value": "zip"
            },
            {
              "type": "type",
              "selector": "cid=120",
              "text": "1234"
            },
            {
              "type": "select",
              "selector": "cid=3803",
              "value": "on"
            },
            {
              "type": "select",
              "selector": "cid=122",
              "value": "AES-256"
            }
          ]
        },
        {
          "say": "ところが、出来た書庫を開くとパスワードを訊かれません。中のファイル名が、そのまま全部読めます。",
          "subtitle": "開いてもパスワードを訊かれず、ファイル名が全部読める",
          "hold": 3.0,
          "audio": "voice/003_leak.wav",
          "actions": [
            {
              "type": "click",
              "selector": "cid=1"
            },
            {
              "type": "wait_for",
              "selector": "win=gmp\\sample",
              "seconds": 30
            },
            {
              "type": "wait_for",
              "selector": "row=sample.zip",
              "seconds": 30
            },
            {
              "type": "dblclick",
              "selector": "row=sample.zip"
            },
            {
              "type": "wait_for",
              "selector": "row*=給与明細",
              "seconds": 20
            }
          ]
        }
      ],
      "goal": {
        "says": "パスワード付きの zip を開いても、中のファイル名が並んでいる",
        "selector": "cid=1001",
        "contains": "給与明細_2026-07.pdf"
      }
    },
    {
      "id": "why",
      "title": "原因は暗号の強さではない",
      "beats": [
        {
          "say": "原因は暗号の強さではありません。zip という形式が、ファイル名の一覧を暗号化しない決まりだからです。",
          "subtitle": "zip は「ファイル名の一覧」を暗号化しない決まりになっている",
          "audio": "voice/004_why.wav"
        },
        {
          "say": "さきほどの画面をもう一度見ると、暗号化の欄に「ファイル名を暗号化」という項目がありません。",
          "subtitle": "zip では「ファイル名を暗号化」の項目が出てこない",
          "hold": 2.5,
          "audio": "voice/005_why.wav",
          "actions": [
            {
              "type": "press",
              "key": "Backspace"
            },
            {
              "type": "wait_for",
              "selector": "row=sample.zip",
              "seconds": 20
            },
            {
              "type": "click",
              "selector": "row=人事評価シート.xlsx"
            },
            {
              "type": "click",
              "selector": "row=給与明細_2026-07.pdf",
              "modifiers": "Shift"
            },
            {
              "type": "click",
              "selector": "at=0.017,0.09"
            },
            {
              "type": "wait_for",
              "selector": "win=圧縮",
              "seconds": 20
            },
            {
              "type": "type",
              "selector": "cid=1001",
              "text": "sample.zip"
            }
          ]
        }
      ]
    },
    {
      "id": "fix",
      "title": "書庫の形式を変える",
      "beats": [
        {
          "say": "形式を 7z に変えると、その項目が現れます。チェックを入れて作り直します。",
          "subtitle": "形式を 7z にすると「ファイル名を暗号化」が現れる",
          "audio": "voice/006_fix.wav",
          "actions": [
            {
              "type": "select",
              "selector": "cid=104",
              "value": "7z"
            },
            {
              "type": "type",
              "selector": "cid=1001",
              "text": "sample.7z"
            },
            {
              "type": "type",
              "selector": "cid=120",
              "text": "1234"
            },
            {
              "type": "select",
              "selector": "cid=3803",
              "value": "on"
            },
            {
              "type": "select",
              "selector": "cid=4016",
              "value": "on"
            }
          ]
        },
        {
          "say": "今度は開いた時点でパスワードを訊かれます。ファイル名は一つも見えません。",
          "subtitle": "開いた時点でパスワードを訊かれ、ファイル名は見えない",
          "hold": 3.0,
          "audio": "voice/007_fix.wav",
          "actions": [
            {
              "type": "click",
              "selector": "cid=1"
            },
            {
              "type": "wait_for",
              "selector": "win=gmp\\sample",
              "seconds": 30
            },
            {
              "type": "wait_for",
              "selector": "row=sample.7z",
              "seconds": 30
            },
            {
              "type": "dblclick",
              "selector": "row=sample.7z"
            },
            {
              "type": "wait_for",
              "selector": "win=パスワード入力",
              "seconds": 20
            }
          ]
        },
        {
          "say": "隠せるかどうかを決めるのは、暗号の強さではなく書庫の形式です。",
          "subtitle": "隠せるかを決めるのは暗号の強さではなく書庫の形式",
          "hold": 2.5,
          "audio": "voice/008_fix.wav",
          "actions": [
            {
              "type": "type",
              "selector": "cid=120",
              "text": "1234"
            },
            {
              "type": "click",
              "selector": "cid=1"
            },
            {
              "type": "wait_for",
              "selector": "win=gmp\\sample",
              "seconds": 20
            },
            {
              "type": "wait_for",
              "selector": "row*=給与明細",
              "seconds": 20
            }
          ]
        }
      ],
      "goal": {
        "says": "パスワードを入れたあとは中身が見えている",
        "selector": "cid=1001",
        "contains": "給与明細_2026-07.pdf"
      }
    }
  ]
}
